{
  "name": "inkleaf",
  "productName": "Inkleaf",
  "version": "3.1.2",
  "description": "A free, open-source, offline PDF editor: edit text, annotate, sign, fill and build forms, OCR, compress, compare and convert.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/priyanshdas/inkleaf",
  "repository": {
    "type": "git",
    "url": "https://github.com/priyanshdas/inkleaf.git"
  },
  "bugs": {
    "url": "https://github.com/priyanshdas/inkleaf/issues"
  },
  "main": "app/main.js",
  "author": "Priyansh Das",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:core": "node scripts/build.mjs --core",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "i18n": "node scripts/i18n.mjs",
    "test": "node scripts/build.mjs && node tests/smoke.mjs",
    "test:core": "cd core && cargo test",
    "dist": "node scripts/build.mjs && electron-builder --publish never",
    "dist:win": "node scripts/build.mjs && electron-builder --win --publish never",
    "dist:win:store": "node scripts/build.mjs && electron-builder --win appx --x64 --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --publish never",
    "dist:linux": "node scripts/build.mjs && electron-builder --linux --publish never",
    "release:win": "node scripts/build.mjs && electron-builder --win --publish always",
    "release": "node scripts/build.mjs && electron-builder --publish always",
    "build:mobile": "node scripts/build-mobile.mjs && cap sync",
    "android:apk": "node scripts/android.mjs",
    "android:release": "node scripts/android.mjs --release"
  },
  "devDependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@capawesome/capacitor-file-picker": "8.1.1",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@expo-google-fonts/noto-sans-arabic": "0.4.3",
    "@expo-google-fonts/noto-sans-armenian": "0.4.2",
    "@expo-google-fonts/noto-sans-bengali": "0.4.4",
    "@expo-google-fonts/noto-sans-devanagari": "0.4.1",
    "@expo-google-fonts/noto-sans-ethiopic": "0.4.2",
    "@expo-google-fonts/noto-sans-georgian": "0.4.3",
    "@expo-google-fonts/noto-sans-gujarati": "0.4.2",
    "@expo-google-fonts/noto-sans-gurmukhi": "0.4.1",
    "@expo-google-fonts/noto-sans-hebrew": "0.4.1",
    "@expo-google-fonts/noto-sans-kannada": "0.4.3",
    "@expo-google-fonts/noto-sans-khmer": "0.4.3",
    "@expo-google-fonts/noto-sans-lao": "0.4.2",
    "@expo-google-fonts/noto-sans-malayalam": "0.4.2",
    "@expo-google-fonts/noto-sans-myanmar": "0.4.2",
    "@expo-google-fonts/noto-sans-oriya": "0.4.2",
    "@expo-google-fonts/noto-sans-sinhala": "0.4.2",
    "@expo-google-fonts/noto-sans-tamil": "0.4.3",
    "@expo-google-fonts/noto-sans-telugu": "0.4.2",
    "@expo-google-fonts/noto-sans-thai": "0.4.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/ben": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "@tesseract.js-data/ita": "1.0.0",
    "@types/node": "^22.20.5",
    "docx": "9.8.1",
    "electron": "^44.9.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "exceljs": "4.4.0",
    "jsqr": "1.4.0",
    "jszip": "3.10.2",
    "lucide-static": "^1.60.0",
    "mammoth": "1.13.0",
    "marked": "18.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "pptxgenjs": "4.0.1",
    "qrcode-generator": "2.0.4",
    "tesseract.js": "7.0.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "io.github.priyanshdas.inkleaf",
    "productName": "Inkleaf",
    "copyright": "Copyright © 2026 Priyansh Das",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json",
      "!**/*.map"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "appx": {
      "applicationId": "Inkleaf",
      "identityName": "PriyanshDas.InkLeaf",
      "publisher": "CN=6862D623-F74B-49DF-80AE-FB42001FAFC6",
      "publisherDisplayName": "Priyansh Das",
      "displayName": "Inkleaf",
      "backgroundColor": "#111111",
      "showNameOnTiles": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup.${ext}",
      "license": "build/installer-terms.txt"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Inkleaf uses the camera only when you choose Scan to PDF, to photograph paper pages. The pictures stay on your Mac."
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "executableName": "inkleaf",
      "artifactName": "${productName}-linux-${arch}.${ext}",
      "synopsis": "Free, open-source PDF editor",
      "description": "Edit, sign, fill, convert and organise PDFs. Everything happens on your computer.",
      "maintainer": "Priyansh Das <75964362+priyanshdas@users.noreply.github.com>",
      "syncDesktopName": true,
      "mimeTypes": [
        "application/pdf"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "priyanshdas",
        "repo": "inkleaf-releases",
        "releaseType": "release"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false,
      "onlyLoadAppFromAsar": true
    },
    "portable": {
      "artifactName": "${productName}-Portable.${ext}"
    },
    "extraResources": [
      {
        "from": "THIRD-PARTY.md",
        "to": "THIRD-PARTY.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "TERMS.md",
        "to": "TERMS.md"
      },
      {
        "from": "PRIVACY.md",
        "to": "PRIVACY.md"
      }
    ],
    "dmg": {
      "sign": false,
      "artifactName": "${productName}-mac-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-linux-${arch}.${ext}"
    },
    "rpm": {
      "artifactName": "${productName}-linux-${arch}.${ext}"
    },
    "releaseInfo": {
      "releaseNotes": "Download the right file for your computer:\n\n- **Windows:** `Inkleaf-Setup.exe` (or `Inkleaf-Portable.exe`, no install needed)\n- **Mac:** coming soon\n- **Ubuntu, Debian, Mint:** `Inkleaf-linux-amd64.deb`\n- **Fedora, openSUSE:** `Inkleaf-linux-x86_64.rpm`\n- **Any other Linux:** `Inkleaf-linux-x86_64.AppImage` (ARM: the `arm64` files)\n\nWhat's new: https://github.com/priyanshdas/inkleaf#readme\n\n**Code signing policy:** https://priyanshdas.github.io/inkleaf/#code-signing"
    }
  },
  "desktopName": "inkleaf.desktop",
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "bidi-js": "1.1.0",
    "electron-updater": "6.8.10",
    "harfbuzzjs": "1.6.4",
    "regenerator-runtime": "0.14.1"
  }
}
