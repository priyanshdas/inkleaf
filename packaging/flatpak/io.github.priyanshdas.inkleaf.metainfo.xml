<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.priyanshdas.inkleaf</id>
  <name>Inkleaf</name>
  <summary>Free, open-source offline PDF editor</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.priyanshdas">
    <name>Priyansh Das</name>
  </developer>
  <description>
    <p>Inkleaf edits, signs, fills, converts and organises PDFs. Everything happens on your computer: nothing is uploaded, there are no accounts, and every tool is free.</p>
    <p>It changes the text that is actually in the file, so the old words are really gone. It also signs documents, fills forms, cleans up scans and handles pages.</p>
  </description>
  <categories>
    <category>Office</category>
    <category>Viewer</category>
  </categories>
  <keywords>
    <keyword>PDF</keyword>
    <keyword>edit</keyword>
    <keyword>sign</keyword>
    <keyword>form</keyword>
    <keyword>scan</keyword>
  </keywords>
